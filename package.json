{
  "name": "team-workspace-app",
  "version": "1.0.0",
  "description": "A full-stack project management tool built with MERN",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "start:backend": "npm run dev --workspace=server",
    "start:frontend": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}